# Copy to .env for local development: cp .env.example .env
#
# Values already present in the process environment take precedence over this
# file, so `CACHE_ADDR=other:6379 go run ./cmd/server` overrides what is here.
# Every variable is optional; the defaults below match internal/config.

# --- HTTP ---------------------------------------------------------------
HTTP_ADDR=:8080
# Grace period for in-flight requests on SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=10s
# Gin's own startup output; set to release for quiet logs.
GIN_MODE=debug

# --- Logging ------------------------------------------------------------
# trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=debug
# json for machines, console for humans.
LOG_FORMAT=console

# --- Database (SQLite via GORM) -----------------------------------------
# Directory is created on startup. Use :memory: for a throwaway database.
DATABASE_PATH=data/app.db
DATABASE_MAX_CONNS=4
# How long a writer waits for the lock before failing.
DATABASE_BUSY_TIMEOUT=5s
# Log every statement at debug level; slow queries warn regardless.
DATABASE_LOG_SQL=false

# --- Cache (Valkey / Redis) ---------------------------------------------
CACHE_ADDR=127.0.0.1:6379
# Leave empty when the server has no AUTH.
CACHE_PASSWORD=
CACHE_DB=0
# Cached user lifetime; <=0 disables caching.
CACHE_TTL=5m
CACHE_TIMEOUT=2s
